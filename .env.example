# Copy to private .env.local and replace placeholders.
# Use a development database with MongoDB transaction support.
# The local URI assumes a replica set named rs0 already exists.
MONGODB_URI=mongodb://127.0.0.1:27017/soundtrack-explorer?replicaSet=rs0
JWT_SECRET=replace-with-a-private-secret

# Contact delivery requires private Resend and recipient settings.
RESEND_API_KEY=
CONTACT_EMAIL=

# Keep OAuth disabled while release gates remain unresolved.
SPOTIFY_ENABLED=false

# Optional local Spotify configuration; see docs/spotify-configuration.md.
# SPOTIFY_CLIENT_ID=replace-with-your-32-character-client-id
# SPOTIFY_FRONTEND_ORIGIN=http://127.0.0.1:3001
# SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/api/spotify/callback
# SPOTIFY_TOKEN_ENCRYPTION_KEYS={"local1":"replace-with-private-base64-32-byte-key"}
# SPOTIFY_TOKEN_ACTIVE_KEY_ID=local1

# Next.js port: npm run dev -- --port 3000
# VERCEL_ENV is supplied by Vercel; do not set it here.
